# =============================================================================
# WisdomKernel backend configuration
# Copy this file to .env and fill in your values:   cp .env.example .env
# NEVER commit the real .env file. NEVER hardcode keys in source.
# =============================================================================

# ---------- AI services (OpenAI-compatible) ----------
# Leave AI_API_KEY blank to run fully offline: /transcribe returns a clearly
# labelled sample transcript and a deterministic rule-based extraction instead
# of crashing. The demo always works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1

# Model names (any OpenAI-compatible provider)
STT_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Set to true to rank /search with embeddings + cosine similarity.
# When false (default) search uses the deterministic keyword ranker, which
# needs no network and never fails.
USE_EMBEDDINGS=false

# Seconds before an AI request is abandoned and the fallback is used.
AI_TIMEOUT_SECONDS=60

# ---------- Uploads ----------
# Maximum accepted audio upload size, in megabytes.
MAX_UPLOAD_MB=25

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins. Do not use "*" in production.
# Vite dev server = 5173, Create React App = 3000.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ---------- Prototype auth ----------
# Organization session token lifetime in seconds (default 8 hours).
TOKEN_TTL_SECONDS=28800
